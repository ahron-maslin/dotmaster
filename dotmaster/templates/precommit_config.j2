# .pre-commit-config.yaml — generated by dotmaster
# https://pre-commit.com — run `pre-commit install` once to activate.
repos:
{% if linter == 'ruff' or formatter == 'ruff' %}
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.8.0
    hooks:
{% if linter == 'ruff' %}
      - id: ruff
        args: [--fix]
{% endif %}
{% if formatter == 'ruff' %}
      - id: ruff-format
{% endif %}
{% endif %}
{% if formatter == 'black' %}
  - repo: https://github.com/psf/black
    rev: 24.10.0
    hooks:
      - id: black
{% endif %}
{% if linter == 'eslint' %}
  - repo: https://github.com/pre-commit/mirrors-eslint
    rev: v9.14.0
    hooks:
      - id: eslint
{% endif %}
{% if formatter == 'prettier' %}
  - repo: https://github.com/pre-commit/mirrors-prettier
    rev: v4.0.0-alpha.8
    hooks:
      - id: prettier
{% endif %}
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v5.0.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-merge-conflict
      - id: check-added-large-files
        args: [--maxkb=1024]
      - id: detect-private-key
