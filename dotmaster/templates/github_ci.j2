# ==============================================================================
# GitHub Actions — CI workflow
# Generated by dotmaster
# ==============================================================================
name: CI

on:
  push:
    branches: [main, master, develop]
  pull_request:
    branches: [main, master, develop]

{% raw %}
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true
{% endraw %}

jobs:
{% if has_node %}
  # ── Node.js checks ──────────────────────────────────────────────────────────
  node:
    name: Node.js — Lint & Test
    runs-on: ubuntu-latest
    strategy:
      matrix:
        node-version: [18, 20]
    steps:
      - uses: actions/checkout@v4

{% raw %}
      - name: Set up Node ${{ matrix.node-version }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ matrix.node-version }}
{% endraw %}
{% if package_manager == 'pnpm' %}
          cache: pnpm
{% elif package_manager == 'yarn' %}
          cache: yarn
{% else %}
          cache: npm
{% endif %}

{% if package_manager == 'pnpm' %}
      - name: Enable pnpm
        uses: pnpm/action-setup@v3
        with:
          version: latest
{% endif %}

      - name: Install dependencies
{% if package_manager == 'pnpm' %}
        run: pnpm install --frozen-lockfile
{% elif package_manager == 'yarn' %}
        run: yarn install --frozen-lockfile
{% else %}
        run: npm ci
{% endif %}

{% if linter == 'eslint' %}
      - name: Lint
{% if package_manager == 'pnpm' %}
        run: pnpm run lint
{% elif package_manager == 'yarn' %}
        run: yarn run lint
{% else %}
        run: npm run lint
{% endif %}
{% endif %}

{% if formatter == 'prettier' %}
      - name: Format check
{% if package_manager == 'pnpm' %}
        run: pnpm run format:check
{% elif package_manager == 'yarn' %}
        run: yarn run format:check
{% else %}
        run: npm run format:check
{% endif %}
{% endif %}

{% if testing in ('jest', 'vitest') %}
      - name: Test
{% if package_manager == 'pnpm' %}
        run: pnpm test{% if testing == 'jest' %} -- --coverage{% endif %}

{% elif package_manager == 'yarn' %}
        run: yarn test{% if testing == 'jest' %} -- --coverage{% endif %}

{% else %}
        run: npm test{% if testing == 'jest' %} -- --coverage{% endif %}

{% endif %}
{% endif %}

{% if framework == 'nextjs' %}
      - name: Build
{% if package_manager == 'pnpm' %}
        run: pnpm run build
{% elif package_manager == 'yarn' %}
        run: yarn run build
{% else %}
        run: npm run build
{% endif %}
{% endif %}

{% endif %}
{% if has_python %}
  # ── Python checks ───────────────────────────────────────────────────────────
  python:
    name: Python — Lint & Test
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ["3.11", "3.12", "3.13"]
    steps:
      - uses: actions/checkout@v4

{% raw %}
      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
{% endraw %}

{% if package_manager == 'poetry' %}
      - name: Install Poetry
        uses: snok/install-poetry@v1
        with:
          virtualenvs-create: true
          virtualenvs-in-project: true

      - name: Install dependencies
        run: poetry install --no-interaction

{% elif package_manager == 'uv' %}
      - name: Install uv
        uses: astral-sh/setup-uv@v3

      - name: Install dependencies
        run: uv sync

{% else %}
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          if [ -f requirements-dev.txt ]; then pip install -r requirements.txt -r requirements-dev.txt
          elif [ -f requirements.txt ]; then pip install -r requirements.txt
          else pip install -e ".[dev]" 2>/dev/null || pip install -e .
          fi

{% endif %}
{% if linter == 'ruff' %}
      - name: Ruff lint
{% if package_manager == 'poetry' %}
        run: poetry run ruff check .
{% elif package_manager == 'uv' %}
        run: uv run ruff check .
{% else %}
        run: ruff check .
{% endif %}

{% endif %}
{% if formatter == 'black' %}
      - name: Black format check
{% if package_manager == 'poetry' %}
        run: poetry run black --check .
{% elif package_manager == 'uv' %}
        run: uv run black --check .
{% else %}
        run: black --check .
{% endif %}

{% endif %}
{% if testing == 'pytest' %}
      - name: Pytest
{% if package_manager == 'poetry' %}
        run: poetry run pytest --tb=short
{% elif package_manager == 'uv' %}
        run: uv run pytest --tb=short
{% else %}
        run: pytest --tb=short
{% endif %}
{% endif %}

{% endif %}
{% if has_go %}
  # ── Go checks ───────────────────────────────────────────────────────────────
  go:
    name: Go — Lint & Test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Go
        uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
          cache: true

      - name: Vet
        run: go vet ./...

      - name: Test
        run: go test -race -coverprofile=coverage.txt ./...

      - name: golangci-lint
        uses: golangci/golangci-lint-action@v6
        with:
          version: latest

{% endif %}
{% if docker %}
  # ── Docker build ────────────────────────────────────────────────────────────
  docker:
    name: Docker — Build image
    runs-on: ubuntu-latest
{% set needs = [] %}
{% if has_node %}{% set _ = needs.append('node') %}{% endif %}
{% if has_python %}{% set _ = needs.append('python') %}{% endif %}
{% if has_go %}{% set _ = needs.append('go') %}{% endif %}
{% if needs %}
    needs: [{{ needs | join(', ') }}]
{% endif %}
    steps:
      - uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build image
        uses: docker/build-push-action@v5
        with:
          context: .
          push: false
          tags: {{ (project_name or 'app') | lower | replace(' ', '-') }}:ci
          cache-from: type=gha
          cache-to: type=gha,mode=max
{% endif %}
