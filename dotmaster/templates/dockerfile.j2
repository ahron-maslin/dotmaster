{% if has_python %}
{% if multistage %}
# ── Stage 1: Builder ──────────────────────────────────────────────────────────
FROM python:3.12-slim AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

{% if package_manager == 'poetry' %}
COPY pyproject.toml poetry.lock* ./
RUN pip install --no-cache-dir poetry && \
    poetry config virtualenvs.create false && \
    poetry install --only main --no-interaction --no-ansi
{% elif package_manager == 'uv' %}
COPY pyproject.toml uv.lock* ./
RUN pip install --no-cache-dir uv && uv sync --no-dev --no-editable
{% elif has_requirements %}
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
{% else %}
COPY pyproject.toml ./
RUN pip install --no-cache-dir .
{% endif %}

COPY . .

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime
WORKDIR /app

RUN addgroup --system app && adduser --system --group app

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /app /app

USER app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000

EXPOSE ${PORT}

{% if framework == 'fastapi' %}
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
{% elif framework == 'django' %}
CMD ["gunicorn", "core.wsgi:application", "--bind", "0.0.0.0:8000"]
{% elif framework == 'flask' %}
CMD ["gunicorn", "app:app", "--bind", "0.0.0.0:8000"]
{% else %}
CMD ["python", "main.py"]
{% endif %}
{% else %}
# ── Single-stage ──────────────────────────────────────────────────────────────
FROM python:3.12-slim
WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN addgroup --system app && adduser --system --group app

{% if package_manager == 'poetry' %}
COPY pyproject.toml poetry.lock* ./
RUN pip install --no-cache-dir poetry && \
    poetry config virtualenvs.create false && \
    poetry install --only main --no-interaction
{% elif package_manager == 'uv' %}
COPY pyproject.toml uv.lock* ./
RUN pip install --no-cache-dir uv && uv sync --no-dev --no-editable
{% elif has_requirements %}
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
{% else %}
COPY pyproject.toml ./
RUN pip install --no-cache-dir .
{% endif %}

COPY . .
RUN chown -R app:app /app
USER app

EXPOSE 8000

{% if framework == 'fastapi' %}
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
{% elif framework == 'django' %}
CMD ["gunicorn", "core.wsgi:application", "--bind", "0.0.0.0:8000"]
{% elif framework == 'flask' %}
CMD ["gunicorn", "app:app", "--bind", "0.0.0.0:8000"]
{% else %}
CMD ["python", "main.py"]
{% endif %}
{% endif %}
{% elif has_node %}
{% if multistage %}
# ── Stage 1: Dependencies ─────────────────────────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app
{% if package_manager == 'pnpm' %}
COPY package.json pnpm-lock.yaml* ./
RUN corepack enable && pnpm install --frozen-lockfile
{% elif package_manager == 'yarn' %}
COPY package.json yarn.lock* ./
RUN yarn install --frozen-lockfile
{% else %}
COPY package.json package-lock.json* ./
RUN npm ci
{% endif %}

# ── Stage 2: Builder ──────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
{% if package_manager == 'pnpm' %}
RUN corepack enable && pnpm run build
{% elif package_manager == 'yarn' %}
RUN yarn run build
{% else %}
RUN npm run build
{% endif %}

# ── Stage 3: Runtime ─────────────────────────────────────────────────────────
FROM node:20-alpine AS runtime
WORKDIR /app

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 appuser

{% if framework == 'nextjs' and standalone_next %}
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
{% elif framework == 'nextjs' %}
# next.config.js does not set `output: "standalone"` yet — copying the full
# build output instead. Set it and re-run `dotmaster sync` for a smaller image.
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
{% else %}
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
{% endif %}

USER appuser

ENV NODE_ENV=production \
    PORT=3000

EXPOSE ${PORT}

{% if framework == 'nextjs' and standalone_next %}
CMD ["node", "server.js"]
{% elif framework == 'nextjs' %}
CMD ["npx", "next", "start"]
{% else %}
CMD ["node", "dist/index.js"]
{% endif %}
{% else %}
# ── Single-stage ──────────────────────────────────────────────────────────────
FROM node:20-alpine
WORKDIR /app

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 appuser

COPY package.json package-lock.json* ./
RUN npm ci --omit=dev
COPY . .
RUN chown -R appuser:nodejs /app
USER appuser

ENV NODE_ENV=production \
    PORT=3000

EXPOSE ${PORT}
CMD ["node", "dist/index.js"]
{% endif %}
{% elif has_go %}
