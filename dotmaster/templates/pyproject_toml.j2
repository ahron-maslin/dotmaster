# ==============================================================================
# pyproject.toml — generated by dotmaster
# ==============================================================================

[build-system]
{% if package_manager == 'poetry' %}
requires = ["poetry-core"]
build-backend = "poetry.core.masonry.api"
{% else %}
requires = ["hatchling"]
build-backend = "hatchling.build"
{% endif %}

[project]
name = "{{ slug }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
license = { text = "{{ license }}" }
requires-python = ">=3.10"
{% if author %}
authors = [{ name = "{{ author }}" }]
{% endif %}
dependencies = [
{% if framework == 'fastapi' %}
    "fastapi>=0.110.0",
    "uvicorn[standard]>=0.29.0",
    "pydantic>=2.6.0",
{% elif framework == 'django' %}
    "django>=5.0",
    "gunicorn>=22.0",
{% elif framework == 'flask' %}
    "flask>=3.0",
    "gunicorn>=22.0",
{% endif %}
]

{% if use_pytest or use_black %}
[project.optional-dependencies]
dev = [
{% if use_black %}
    "black",
{% endif %}
{% if use_pytest %}
    "pytest",
    "pytest-cov",
{% endif %}
]
{% endif %}

{% if package_manager == 'poetry' %}
[tool.poetry]
name = "{{ slug }}"
version = "0.1.0"
description = "{{ description }}"
{% if author %}
authors = ["{{ author }}"]
{% endif %}

[tool.poetry.dependencies]
python = "^3.10"
{% if framework == 'fastapi' %}
fastapi = "^0.110.0"
uvicorn = { version = "^0.29.0", extras = ["standard"] }
pydantic = "^2.6.0"
{% elif framework == 'django' %}
django = "^5.0"
gunicorn = "^22.0"
{% elif framework == 'flask' %}
flask = "^3.0"
gunicorn = "^22.0"
{% endif %}

{% if use_black or use_pytest %}
[tool.poetry.group.dev.dependencies]
{% if use_black %}
black = "*"
{% endif %}
{% if use_pytest %}
pytest = "*"
pytest-cov = "*"
{% endif %}
{% endif %}
{% endif %}

{% if use_black %}
# ── Black ─────────────────────────────────────────────────────────────────────
[tool.black]
line-length = 88
target-version = ["py310", "py311", "py312"]
{% endif %}

{% if use_pytest %}
# ── Pytest ────────────────────────────────────────────────────────────────────
[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-v --tb=short"
{% endif %}
